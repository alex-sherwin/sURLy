    "@types/webpack-env": "1.14.1",
    "@types/yup": "0.26.26",
    "@zeit/webpack-asset-relocator-loader": "0.6.2",
    "autoprefixer": "9.7.3",
    "babel-loader": "8.0.6",
    "babel-plugin-styled-components": "1.10.6",
    "cache-loader": "4.1.0",
    "classnames": "2.2.6",
    "compression": "1.7.4",
    "copy-webpack-plugin": "5.1.1",
    "core-js": "3.6.0",
    "cross-env": "6.0.3",
    "css-loader": "3.3.2",
    "cssnano": "4.1.10",
    "date-fns": "2.8.1",
    "electron-builder": "21.2.0",
    "electron-devtools-installer": "2.2.4",
    "electron": "7.1.7",
    "express": "4.17.1",
    "file-loader": "5.0.2",
    "fork-ts-checker-webpack-plugin": "3.1.1",
