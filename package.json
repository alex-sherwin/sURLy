{
  "name": "sURLy",
  "version": "0.0.1",
  "description": "",
  "main": "./dist/main.js",
  "scripts": {
    "clean": "rimraf dist release",
    "build-main": "cross-env NODE_ENV=production webpack --config webpack.main.prod.config.js",
    "build-main-dev": "cross-env NODE_ENV=development webpack --config webpack.main.config.js",
    "build-renderer": "cross-env NODE_ENV=production webpack --config webpack.renderer.prod.config.js",
    "build-renderer-dev": "cross-env NODE_ENV=development webpack --config webpack.renderer.dev.config.js",
    "build": "yarn run build-main && yarn run build-renderer",
    "build-dev": "yarn run build-main-dev && yarn run build-renderer-dev",
    "start-renderer-dev": "webpack-dev-server --config webpack.renderer.dev.config.js",
    "start-main-dev": "webpack --config webpack.main.config.js && electron ./dist/main.js",
    "start-dev": "cross-env START_HOT=1 yarn run start-renderer-dev",
    "prestart": "yarn run build",
    "start": "electron .",
    "lint": "tslint '{src,test,mocks}/**/*.{ts,tsx}' --project ./tsconfig.json",
    "test": "jest '(\\/test\\/(?!e2e/)).*'",
    "pretest:e2e": "yarn run build",
    "test:e2e": "jest '(\\/test\\/e2e/).*'",
    "pack": "yarn run build && electron-builder --dir",
    "pack-dev": "yarn run build-dev && electron-builder --dir",
    "dist": "yarn run build && electron-builder",
    "dist-multi": "yarn run build && electron-builder -mwl",
    "tsc": "tsc",
    "tsc-watch": "tsc --watch",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
  },
  "devDependencies": {
    "@ag-grid-community/core": "22.1.1",
    "@ag-grid-community/react": "22.1.1",
    "@babel/core": "7.7.7",
    "@babel/plugin-proposal-class-properties": "7.7.4",
    "@babel/plugin-proposal-nullish-coalescing-operator": "7.7.4",
    "@babel/plugin-proposal-object-rest-spread": "7.7.7",
    "@babel/polyfill": "7.7.0",
    "@babel/preset-env": "7.7.7",
    "@babel/preset-react": "7.7.4",
    "@babel/preset-typescript": "7.7.7",
    "@capecodes/node-libcurl": "2.0.2",
    "@date-io/core": "1.3.13",
    "@fortawesome/fontawesome-svg-core": "1.2.26",
    "@fortawesome/pro-duotone-svg-icons": "5.12.0",
    "@fortawesome/pro-light-svg-icons": "5.12.0",
